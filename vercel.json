{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/atmosphere",
      "destination": "/api/mono?route=atmosphere"
    },
    {
      "source": "/api/cosmic-events",
      "destination": "/api/mono?route=cosmic-events"
    },
    {
      "source": "/api/earth-signals",
      "destination": "/api/mono?route=earth-signals"
    },
    {
      "source": "/api/history",
      "destination": "/api/mono?route=history"
    },
    {
      "source": "/api/netatmo",
      "destination": "/api/mono?route=netatmo"
    },
    {
      "source": "/api/news",
      "destination": "/api/mono?route=news"
    },
    {
      "source": "/api/nexus",
      "destination": "/api/mono?route=nexus"
    },
    {
      "source": "/api/outlook",
      "destination": "/api/mono?route=outlook"
    },
    {
      "source": "/api/rain-memory",
      "destination": "/api/mono?route=rain-memory"
    },
    {
      "source": "/api/space-weather",
      "destination": "/api/mono?route=space-weather"
    },
    {
      "source": "/api/storm-lens",
      "destination": "/api/mono?route=storm-lens"
    },
    {
      "source": "/api/synop",
      "destination": "/api/mono?route=synop"
    },
    {
      "source": "/api/verify",
      "destination": "/api/mono?route=verify"
    },
    {
      "source": "/api/weather-maps",
      "destination": "/api/mono?route=weather-maps"
    },
    {
      "source": "/proxy/mono-forecast",
      "destination": "https://api.open-meteo.com/v1/forecast"
    },
    {
      "source": "/proxy/mono-ensemble",
      "destination": "https://ensemble-api.open-meteo.com/v1/ensemble"
    },
    {
      "source": "/proxy/mono-previous",
      "destination": "https://previous-runs-api.open-meteo.com/v1/forecast"
    },
    {
      "source": "/proxy/mono-archive",
      "destination": "https://archive-api.open-meteo.com/v1/archive"
    },
    {
      "source": "/proxy/awc/:path*",
      "destination": "https://aviationweather.gov/:path*"
    },
    {
      "source": "/proxy/meteoalarm/:path*",
      "destination": "https://feeds.meteoalarm.org/:path*"
    },
    {
      "source": "/proxy/meteostat/:path*",
      "destination": "https://bulk.meteostat.net/:path*"
    },
    {
      "source": "/proxy/rv/:path*",
      "destination": "https://tilecache.rainviewer.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/proxy/mono-forecast",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=180, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/proxy/mono-ensemble",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=900, stale-while-revalidate=1800"
        }
      ]
    },
    {
      "source": "/proxy/mono-previous",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=14400, stale-while-revalidate=28800"
        }
      ]
    },
    {
      "source": "/proxy/mono-archive",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=21600, stale-while-revalidate=43200"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self'; connect-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ],
  "functions": {
    "api/mono.js": {
      "maxDuration": 60
    }
  }
}
